ARCANA "syntax_test" {
    ORACLE @arithmetic ~> {
        BIND($r0) ::= #-42;
        BIND($r1) ::= $r0;
        BIND($r2) ::= SIGIL("literal");
        BIND($r3) ::= $r0 <+> $r1;
        BIND($r3) ::= $r3 <-> #1;
        BIND($r3) ::= $r3 <*> #2;
        BIND($r3) ::= $r3 </> #2;
        BIND($r3) ::= $r3 <%> #7;
        BIND($r3) ::= $r3 <&> #255;
        BIND($r3) ::= $r3 <|> #1;
        BIND($r3) ::= $r3 <^> #3;
        BIND($r3) ::= $r3 <<> #1;
        BIND($r3) ::= $r3 <>> #1;
        NEGATE($r3);
        COMPLEMENT($r3);
        INCREMENT($r3);
        DECREMENT($r3);
        POPCOUNT($r3);
        LEADING_ZEROS($r3);
        TRAILING_ZEROS($r3);
        BYTESWAP($r3);
        BIND($r3) ::= $r3 <rol> #3;
        BIND($r3) ::= $r3 <ror> #3;
        SWAP($r3, $r4);
        BIND($r0) ::= $a0 <+> $a1;
        RETURN;
    }

    ORACLE @memory ~> {
        BIND($r4) ::= #0;
        BIND($r0) ::= #8;
        SCRIBE MEM[$r4 + #0] ::= $a0;
        SCRIBE MEM[$r4 + #8] ::= #99;
        SCRIBE MEM[$r0 + #16] ::= $a1;
        REVEAL($r5) ::= MEM[$r4 + #0];
        REVEAL($r6) ::= MEM[$r0 + #8];
        REVEAL($r7) ::= MEM[$r4 + $r0];
        SCRIBE8 MEM8[$r4 + #24] ::= $r5;
        REVEAL8($r8) ::= MEM8[$r4 + #24];
        PUSH($r5);
        PUSH($r6);
        POP($r7);
        POP($r8);
        RETURN;
    }

    ORACLE @conditions ~> {
        BIND($r0) ::= $a0;
        VERIFY($r0) <=> $a1;
        WHEN::EQUAL => GATE @equal;
        WHEN::NOT_EQUAL => GATE @not_equal;
        WHEN::LESS => GATE @less;
        WHEN::GREATER => GATE @greater;
        WHEN::LESS_OR_EQUAL => GATE @less_equal;
        WHEN::GREATER_OR_EQUAL => GATE @greater_equal;
        WHEN::ZERO => GATE @zero;
        WHEN::NONZERO => GATE @nonzero;
        WHEN::CARRY => GATE @carry;
        WHEN::NO_CARRY => GATE @no_carry;
        WHEN::OVERFLOW => GATE @overflow;
        WHEN::NO_OVERFLOW => GATE @no_overflow;
        GATE @done;
        @equal::
        GATE @done;
        @not_equal::
        GATE @done;
        @less::
        GATE @done;
        @greater::
        GATE @done;
        @less_equal::
        GATE @done;
        @greater_equal::
        GATE @done;
        @zero::
        GATE @done;
        @nonzero::
        GATE @done;
        @carry::
        GATE @done;
        @no_carry::
        GATE @done;
        @overflow::
        GATE @done;
        @no_overflow::
        GATE @done;
        @done::
        RETURN;
    }

    ORACLE @calls ~> {
        BIND($r0) ::= #0;
        CALL @helper;
        CALL @arithmetic;
        HALT;
        @helper::
        NOP;
        BIND($r0) ::= $r0 <+> #1;
        RETURN;
    }

    ORACLE @host_calls ~> {
        BIND($a0) ::= SIGIL("&aOBLVN syntax test");
        BIND($a1) ::= #1;
        BIND($a2) ::= #2;
        BIND($a3) ::= #3;
        SUMMON(#1);
        SUMMON(#2);
        SUMMON(#3);
        SUMMON(#4);
        SUMMON(#5);
        SUMMON(#7);
        RETURN;
    }

    ORACLE @trap_form ~> {
        TRAP(#99);
        HALT;
    }
}
